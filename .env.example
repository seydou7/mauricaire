# ==============================================================================
# MAURICARE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT (.env.local / Vite / Client-Side)
# ------------------------------------------------------------------------------
# Convex deployment client URL (format: https://<deployment-name>.convex.cloud or http://127.0.0.1:3210)
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# ------------------------------------------------------------------------------
# 2. CONVEX DEPLOYMENT ENVIRONMENT (Set via: npx convex env set <NAME> <VALUE>)
# ------------------------------------------------------------------------------
# Canonical frontend site URL required by @convex-dev/auth:
# - Local development: http://localhost:5173
# - Production: https://your-domain.com
SITE_URL=http://localhost:5173

# Convex Auth JWT / JWKS cryptographic keys (Generated by: npx @convex-dev/auth)
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWKS={"keys":[{"kty":"RSA",...}]}

# Email OTP delivery service (Production mail-provider variables)
# VLY_API_KEY=your_production_api_key
# VLY_APP_NAME=MauriCare

# Development Auth flag (Local QA: DEV_AUTH=true, MUST BE FALSE OR OMITTED IN PRODUCTION)
# DEV_AUTH=true
